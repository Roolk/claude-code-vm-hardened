# Managed by ccvm-harden. Sorts before cloud-init's 50-cloud-init.conf; sshd uses
# the FIRST value it sees for a keyword, so these win.
HostKey /etc/ssh/ssh_host_ed25519_key

# --- Authentication: public keys only, one named user, never root ---
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
AllowUsers @ADMIN_USER@
MaxAuthTries 6
MaxSessions 4
LoginGraceTime 30

# --- Session hygiene ---
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
Banner /etc/issue.net
Compression no
PermitUserEnvironment no
PermitTunnel no
GatewayPorts no
X11Forwarding no
AllowAgentForwarding @AGENT_FORWARDING@
AllowTcpForwarding @TCP_FORWARDING@

# --- Modern crypto only (post-quantum hybrid first, then curve25519) ---
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,rsa-sha2-512,rsa-sha2-256
