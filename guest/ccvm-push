#!/usr/bin/env bash
# ccvm-push - push commits to GitHub yourself, from an SSH session, with a token
# you type in. Claude commits; you review and push. The token is read from the
# terminal, used for this one push and never stored.
#
#   cd ~/repos/<repo> && ccvm-push       push the current branch
#   ccvm-push <branch>...                push the named branches
#
# Use a fine-grained token limited to the repo, Contents: Read and write, short expiry.
#
# The repository's own hooks and config are untrusted (Claude can edit them), so:
# hooks are disabled for every git call, the push goes to the verified GitHub URL
# rather than through remote settings, and it is refused if any non-system config
# could redirect the push or the token (url.*, http.*, credential.*, include*,
# core.hooksPath/fsmonitor/sshCommand/askPass, remote.*.pushurl/receivepack, ...).
# It never force-pushes.
set -euo pipefail
export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0
unset GIT_ASKPASS SSH_ASKPASS GIT_DIR GIT_WORK_TREE GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
die() { printf '[FAIL] %s\n' "$*" >&2; exit 1; }
g() { git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"; }

case ${1:-} in
  -h|--help)
    cat <<'EOF'
Usage: ccvm-push                push the current branch of the repo you are in
       ccvm-push <branch>...    push the named branches

Run it yourself in an SSH session, inside the repo. It asks for a GitHub token
(fine-grained, limited to the repo, Contents: Read and write, short expiry),
shows the commits GitHub does not have yet, and pushes after you confirm. It never
force-pushes and never stores the token. The repo's hooks are disabled, and it
refuses if git config could redirect the push or the token.

EOF
    cat /usr/local/share/ccvm/commands.txt 2>/dev/null || echo "(the ccvm command list is not installed)"
    exit 0 ;;
  -*) die "unknown option: $1 (try: ccvm-push -h)" ;;
esac

[[ -t 0 && -r /dev/tty ]] || die "run this yourself, in an interactive SSH session"
g rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# Config that could send the push or the token somewhere else. System config is root-owned;
# "command" scope is only g()'s own -c settings (GIT_CONFIG_PARAMETERS was unset above).
bad=$(g config --list --show-scope --name-only 2>/dev/null | awk '$1 != "system" && $1 != "command" {print $2}' \
  | grep -iE '^(url\.|http\.|credential\.|include\.|includeif\.|protocol\.|core\.(hookspath|fsmonitor|sshcommand|askpass|gitproxy)$|remote\..*\.(pushurl|receivepack|uploadpack|proxy|vcs)$)' || true)
[[ -z $bad ]] || die "refusing: git config could redirect the push or the token:
$bad
Inspect with: git config --list --show-origin"

url=$(g config --get remote.origin.url || true)
[[ $url =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
  || die "refusing: origin is not an https://github.com/<owner>/<repo> URL: ${url:-unset}"

if (( $# )); then branches=("$@")
else
  cur=$(g symbolic-ref --short -q HEAD) || die "detached HEAD: name the branch to push"
  branches=("$cur")
fi
for b in "${branches[@]}"; do
  g check-ref-format --branch "$b" >/dev/null 2>&1 && g show-ref --verify --quiet "refs/heads/$b" \
    || die "no local branch named '$b'"
done

owner_repo=${url#https://github.com/}; owner_repo=${owner_repo%.git}
tmp=$(mktemp -d)
read -rsp "GitHub token for $url: " CCVM_PUSH_TOKEN </dev/tty; echo
[[ -n $CCVM_PUSH_TOKEN ]] || die "no token entered"
export CCVM_PUSH_TOKEN
trap 'unset CCVM_PUSH_TOKEN; rm -rf "$tmp"' EXIT
# shellcheck disable=SC2016  # $CCVM_PUSH_TOKEN is expanded by the helper's shell, not here
auth=(-c credential.helper= -c 'credential.helper=!f() { echo username=x-access-token; echo "password=$CCVM_PUSH_TOKEN"; }; f')

# explain <git stderr file> - show git's output, then say in plain words what went wrong.
explain() {
  local e user
  e=$(<"$1")
  printf '%s\n' "$e" | sed 's/^/   git: /' >&2
  if grep -qiE 'refusing to allow .*workflow' <<<"$e"; then
    die "the commits change files in .github/workflows/, which needs the token's Workflows permission.
       Granting it lets anything that can push also change CI and reach its secrets; consider
       making workflow changes on the GitHub website instead."
  elif grep -qE 'GH006|GH013|protected branch|[Rr]epository rule violations' <<<"$e"; then
    die "branch protection or a ruleset on $owner_repo refused the push.
       Push to another branch and open a pull request instead."
  elif user=$(grep -oE 'Permission to [^ ]+ denied to [^ .]+' <<<"$e" | awk '{print $NF}') && [[ -n $user ]]; then
    die "the token works (it belongs to $user) but cannot WRITE to $owner_repo.
       On GitHub, edit the token: Repository access must include $owner_repo, and
       Repository permissions > Contents must be 'Read and write'.
       (For a repo owned by an organization, the organization may also need to approve the token.)"
  elif grep -qE 'returned error: 403' <<<"$e"; then
    die "GitHub refused the push (HTTP 403): the token cannot write to $owner_repo.
       Check its Repository access and that Contents is 'Read and write'."
  elif grep -qiE 'Invalid username or (password|token)|Authentication failed|returned error: 401' <<<"$e"; then
    die "GitHub did not accept the token: it is wrong, expired or revoked."
  elif grep -qiE 'Repository not found|returned error: 404' <<<"$e"; then
    die "the token cannot see $owner_repo: a private repo missing from the token's Repository access,
       or the repo was renamed or moved."
  elif grep -qiE 'non-fast-forward|fetch first|\[rejected\]' <<<"$e"; then
    die "GitHub has commits this branch does not. Pull or merge them first, then push again
       (ccvm-push never force-pushes)."
  elif grep -qiE 'Could not resolve host|Failed to connect|timed out' <<<"$e"; then
    die "could not reach GitHub (network or DNS problem)."
  fi
  die "the push failed; see the git output above."
}

# 1. Is the token valid at all? (The API says who it belongs to and when it expires.)
code=$(printf 'Authorization: Bearer %s\n' "$CCVM_PUSH_TOKEN" \
  | curl -sS --max-time 15 -o "$tmp/user.json" -D "$tmp/user.hdr" -w '%{http_code}' -H @- \
      -H 'Accept: application/vnd.github+json' https://api.github.com/user 2>/dev/null) || code=000
case $code in
  200)
    login=$(sed -n 's/^ *"login": *"\([^"]*\)".*/\1/p' "$tmp/user.json" | head -1)
    expires=$(grep -i '^github-authentication-token-expiration:' "$tmp/user.hdr" | cut -d' ' -f2- | tr -d '\r')
    echo "Token OK: belongs to ${login:-?}${expires:+, expires $expires}." ;;
  401) die "GitHub rejected the token: it is wrong, expired or revoked (nothing was pushed)." ;;
  000) echo "[WARN] could not reach api.github.com to check the token; trying the push anyway." ;;
  *)   echo "[WARN] token check returned HTTP $code; trying the push anyway." ;;
esac

# 2. Can it write? A dry-run push makes GitHub check push permission without sending anything.
refspecs=()
for b in "${branches[@]}"; do refspecs+=("refs/heads/$b:refs/heads/$b"); done
LC_ALL=C g "${auth[@]}" push --dry-run "$url" "${refspecs[@]}" 2>"$tmp/dry.err" || explain "$tmp/dry.err"
echo "Write access to $owner_repo confirmed (dry run)."

echo
for b in "${branches[@]}"; do
  remote_sha=$(g "${auth[@]}" ls-remote "$url" "refs/heads/$b" | awk '{print $1}') \
    || die "could not reach $url (wrong token or no access?)"
  if [[ -z $remote_sha ]]; then
    echo "== $b: new branch on GitHub; commits not on any fetched branch (up to 20):"
    g log --oneline --no-decorate -n 20 "$b" --not --remotes
  elif g cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    n=$(g rev-list --count "$remote_sha..$b")
    if (( n == 0 )); then echo "== $b: already up to date"; continue; fi
    echo "== $b: $n commit(s) to push:"
    g log --oneline --no-decorate "$remote_sha..$b"
    g merge-base --is-ancestor "$remote_sha" "$b" \
      || echo "   (GitHub has commits this branch lacks; the push will be rejected - pull first)"
  else
    echo "== $b: GitHub has commits you have not fetched; the push will likely be rejected. Local tip:"
    g log --oneline --no-decorate -n 5 "$b"
  fi
done

echo
read -rp "Push the above to $url? [y/N] " ok </dev/tty
[[ $ok =~ ^[Yy] ]] || { echo "Nothing pushed."; exit 0; }

LC_ALL=C g "${auth[@]}" push "$url" "${refspecs[@]}" 2>"$tmp/push.err" || explain "$tmp/push.err"
cat "$tmp/push.err" >&2

# Pushing to a URL does not update origin/<branch>; record what GitHub now has.
for b in "${branches[@]}"; do
  g update-ref "refs/remotes/origin/$b" "refs/heads/$b"
  g branch --quiet --set-upstream-to="origin/$b" "$b" 2>/dev/null || true
done
echo ">>> pushed. The token was not stored; you can delete it on GitHub now."
